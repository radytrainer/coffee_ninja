# =============================================================
# Gesture Coffee Shop — environment configuration
# Copy to `.env` in the repository root:   cp .env.example .env
# The backend, Prisma CLI, vision service and docker compose all read this file.
# NEVER commit the real .env file.
# =============================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=coffee
POSTGRES_PASSWORD=change-me-local-dev-password
POSTGRES_DB=gesture_coffee
POSTGRES_PORT=5440
DATABASE_URL=postgresql://coffee:change-me-local-dev-password@localhost:5440/gesture_coffee?schema=public
# Separate database used by the automated backend tests (created automatically).
TEST_DATABASE_URL=postgresql://coffee:change-me-local-dev-password@localhost:5440/gesture_coffee_test?schema=public

# ---------- Backend API ----------
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
# Generate a long random value: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3010,http://localhost:3020
# Set true when served over HTTPS in production.
COOKIE_SECURE=false
LOG_LEVEL=info

# Initial accounts created by `npm run db:seed` (change in production!)
SEED_ADMIN_EMAIL=admin@pnccoffee.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_STAFF_EMAIL=barista@pnccoffee.local
SEED_STAFF_PASSWORD=Staff@12345

# ---------- Frontends (Next.js; baked in at build time) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_VISION_WS_URL=ws://localhost:8765/ws/gesture
NEXT_PUBLIC_VISION_HTTP_URL=http://localhost:8765
# gesture | mouse   (mouse = developer/demo mode)
NEXT_PUBLIC_INPUT_MODE=gesture
NEXT_PUBLIC_KIOSK_CODE=KIOSK-01

# ---------- QR payment & smile discount ----------
# demo = the QR opens a test "Pay" page served by the API (no real money moves).
PAYMENT_PROVIDER=demo
# Address phones use to reach the API for the demo pay page. Must be reachable from
# the phone (same Wi-Fi): http://<this-PC-LAN-IP>:4000. Unset = auto-detect (non-Docker only).
PAYMENT_PUBLIC_URL=
# Unpaid orders are cancelled after this many seconds (QR / cash at the counter).
PAYMENT_TIMEOUT_SECONDS=300
CASH_PAYMENT_TIMEOUT_SECONDS=900
# Shared secret between the API and the vision service; signs smile-discount tokens.
# Unset = no smile discount. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SMILE_TOKEN_SECRET=

# ---------- Vision service (Python) ----------
VISION_SERVICE_URL=http://localhost:8765
VISION_HOST=127.0.0.1
VISION_PORT=8765
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
CAMERA_MIRROR=true
# 0..1 — higher = smoother but laggier
CURSOR_SMOOTHING=0.55
# Thumb-index distance / hand size ratio that starts a pinch
PINCH_THRESHOLD=0.33
PINCH_RELEASE_THRESHOLD=0.48
# Milliseconds between accepted pinches
PINCH_COOLDOWN=450
# Minimum MediaPipe confidence for detections / gestures
GESTURE_CONFIDENCE=0.6
# How long an open palm / thumbs-up must be held (ms)
OPEN_PALM_HOLD_MS=1000
THUMBS_UP_HOLD_MS=900
# Close both eyes this long to go back (ms); FACE_GESTURES=false disables the face model
EYES_CLOSED_HOLD_MS=600
FACE_GESTURES=true
# Kiosk-side hover delay before a pinch may activate a button (ms)
HOVER_DELAY=250
VISION_ALLOWED_ORIGINS=http://localhost:3000
